    "@capacitor/core": "^8.5.3",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
